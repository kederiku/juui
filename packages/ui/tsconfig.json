{
  // Configuration TypeScript de `@repo/ui`.
  //
  // Le socle vient desormais du package partage (SHARED-02) :
  // `react-library.json` porte exactement les reglages qu'ecrivait jadis ce
  // fichier -- ils ont ete deplaces, pas retouches.
  //
  // Ne restent ici que les cles dont TypeScript resout les chemins
  // « relativement au fichier de configuration dont ils proviennent », et qu'un
  // tsconfig partage ne peut donc pas porter a la place du consommateur.
  //
  // Le package n'est PAS compile : les applications le consomment en source et
  // le transpilent (`transpilePackages`, FRONT-01). Le `noEmit` du socle dit
  // cela -- `tsc` ne sert ici qu'a verifier les types (`pnpm typecheck`).
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    // Ce qui permet a la CLI shadcn de resoudre les alias de components.json
    // (`@repo/ui/lib/utils`, `@repo/ui/components/...`) a l'interieur meme du
    // package -- sans eux, les composants ajoutes ne compileraient pas ici.
    //
    // Pas de `baseUrl` : TypeScript 6 le declare deprecie (TS5101) et resout
    // desormais les `paths` relativement a CE fichier.
    "paths": {
      "@repo/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
