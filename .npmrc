# Depuis pnpm 11, seuls `auth` et `registry` sont lus dans ce fichier : la source
# de verite des reglages est pnpm-workspace.yaml. Les trois lignes ci-dessous ne
# servent donc qu'a un poste reste en pnpm 10 -- les garder alignees avec
# pnpm-workspace.yaml, ou les supprimer le jour ou plus personne n'y est.
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=false
