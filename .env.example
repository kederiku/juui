# Variables d'environnement de la pile de developpement (SETUP-05).
#
# Ce fichier est un GABARIT : versionne, sans aucun secret reel. Pour obtenir un
# environnement de travail :
#
#   cp .env.example .env
#
# Le `.env` produit est ignore par git ; il ne doit jamais etre commite, meme
# vide. La regle vaut pour tout le depot : le nom du gabarit est celui du
# fichier a creer, suffixe de `.example`.
#
# PERIMETRE
# Ce fichier est lu par `docker compose`. Il alimente deux choses a la fois :
# l'interpolation `${...}` de docker/docker-compose.yml (ports publies, noms de
# volumes) et l'environnement des conteneurs. Le service d'API lance HORS Docker
# ne le lit PAS -- son gabarit est backend/api/.env.example.
#
# ATTENTION : le fichier compose vit dans docker/, pas ici. Sans precaution,
# `docker compose` chercherait son .env dans docker/. Les commandes du README
# passent donc `--project-directory .`, et c'est ce que fera `make up`
# (INFRA-06). Ne jamais deplacer ce fichier dans docker/.
#
# REGLES D'ECRITURE -- les enfreindre produit des valeurs mal lues, sans erreur :
#   - pas de guillemets autour d'une valeur : selon la version de compose ils
#     feraient partie de la valeur ;
#   - pas d'espace autour du signe `=` ;
#   - pas de commentaire en fin de ligne : `#` n'ouvre un commentaire qu'en
#     debut de ligne ;
#   - eviter `$`, `#` et l'espace DANS une valeur : compose interpole `$` ici
#     comme ailleurs.
#
# CONVENTION DE NOMMAGE DES PORTS
#   <SERVICE>_PORT       port ECOUTE par le service, y compris a l'interieur du
#                        reseau Docker `app_network`. Ne quasiment jamais
#                        changer : ce n'est pas lui qui provoque les collisions.
#   <SERVICE>_HOST_PORT  port PUBLIE sur le poste, celui qu'on tape dans un
#                        navigateur ou un client SQL. Le changer n'a d'effet que
#                        sur le poste, jamais entre conteneurs.
#
# Chaque variable nomme le ticket qui la consommera. Tant que ce ticket n'est
# pas livre, la variable est declaree sans effet : c'est voulu. Ce fichier est
# le recensement de reference demande par SETUP-05, pas le reflet de ce qui
# tourne aujourd'hui.


# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# Prefixe de tous les conteneurs, reseaux et volumes de la pile. Sans lui,
# compose prendrait le nom du dossier portant le fichier compose -- soit
# `docker`, qui entrerait en collision avec n'importe quel autre projet organise
# de la meme facon sur le meme poste. Consomme par INFRA-01.
COMPOSE_PROJECT_NAME=juui


# ---------------------------------------------------------------------------
# Application (BACK-03, BACK-11, BACK-14)
# ---------------------------------------------------------------------------

# Environnement d'execution. Valeurs admises : development, staging, production
# -- BACK-03 en fait un Literal, toute autre valeur empeche le demarrage. Pilote
# aussi le format des logs (BACK-11 : JSON en production, lisible en
# developpement) et le prefixe des cles de cache (BACK-14 : `dev:`, `prod:`).
ENVIRONMENT=development

# Seuil de journalisation, aligne sur le module `logging` de Python et donc en
# MAJUSCULES : DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO est le bon defaut ;
# DEBUG rend la sortie SQLAlchemy tres verbeuse. Consomme par BACK-11.
LOG_LEVEL=INFO

# Origines autorisees par CORS, separees par des virgules, SANS barre finale.
# Ce sont les trois frontends en developpement (FRONT-01 a FRONT-03). BACK-11
# impose `allow_credentials=True`, ce qui interdit le joker `*` : la liste doit
# rester explicite. Docusaurus n'appelle pas l'API, il n'y figure pas.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003


# ---------------------------------------------------------------------------
# Service d'API (INFRA-04)
# ---------------------------------------------------------------------------

# Port publie sur le poste ; le conteneur, lui, ecoute sur 8000. Documentation
# interactive : http://localhost:8000/docs
API_HOST_PORT=8000


# ---------------------------------------------------------------------------
# PostgreSQL (INFRA-01, BACK-03, BACK-05)
# ---------------------------------------------------------------------------
# Les trois premieres variables portent les noms IMPOSES par l'image officielle
# `postgres` : les renommer casserait l'initialisation du conteneur. Elles
# servent EN MEME TEMPS d'identifiants a l'API, qui les lit sous ces memes noms
# (BACK-03, sous-modele DatabaseSettings, env_prefix `POSTGRES_`). Une valeur,
# un nom, deux consommateurs : rien a tenir synchronise.
#
# PIEGE : l'image `postgres` ne lit POSTGRES_USER / PASSWORD / DB qu'a la toute
# PREMIERE creation du volume `postgres_data`. Les modifier ensuite reste sans
# effet -- la base garde les anciens identifiants et l'API se voit refuser la
# connexion. Pour repartir de zero :
#   docker compose --project-directory . -f docker/docker-compose.yml down -v

# Compte proprietaire de la base.
POSTGRES_USER=juui

# Mot de passe de ce compte. Valeur de developpement, volontairement evidente :
# la base n'est jamais exposee hors du poste. Un mot de passe de recette ou de
# production n'a RIEN a faire ici -- il vient du gestionnaire de secrets de la
# plateforme d'hebergement.
POSTGRES_PASSWORD=juui-dev-password

# Base applicative, celle que migre Alembic (BACK-07).
POSTGRES_DB=juui

# Base separee reservee aux tests d'integration (BACK-12), qui la vident et la
# recreent -- operation destructrice sur la base applicative. Creee au premier
# demarrage par le script d'initialisation d'INFRA-01. Le nom `app_test` est
# celui du ticket ; cette variable existe precisement pour qu'il reste
# modifiable sans toucher au script.
POSTGRES_TEST_DB=app_test

# Hote joignable par l'API. `postgres` est le NOM DU SERVICE compose : il n'est
# resolvable que depuis le reseau `app_network`. Hors Docker, cette valeur doit
# etre `localhost` -- c'est ce que fait backend/api/.env.example.
POSTGRES_HOST=postgres

# Port ecoute par PostgreSQL dans le reseau Docker.
POSTGRES_PORT=5432

# Port publie sur le poste, pour psql, pgAdmin ou un client graphique. INFRA-01
# demande 5432 par defaut, rendu configurable : passer a 5433 si une instance
# PostgreSQL locale (Homebrew, Postgres.app) occupe deja 5432.
POSTGRES_HOST_PORT=5432

# DSN complet, DERIVE des variables ci-dessus -- volontairement commente.
# BACK-03 construit lui-meme l'URL SQLAlchemy asynchrone (postgresql+asyncpg://)
# a partir des composants : la decommenter creerait une SECONDE source de
# verite, qui divergerait au premier changement de mot de passe. Ne l'activer
# que pour un outil incapable de lire autre chose qu'un DSN. Depuis le poste,
# remplacer `postgres` par `localhost`.
#DATABASE_URL=postgresql+asyncpg://juui:juui-dev-password@postgres:5432/juui


# ---------------------------------------------------------------------------
# pgAdmin (INFRA-01)
# ---------------------------------------------------------------------------
# Noms imposes par l'image `dpage/pgadmin4`.

# Identifiant de connexion a l'interface. L'image EXIGE une adresse
# syntaxiquement valide et refuse de demarrer sinon. Le domaine `example.com`
# est reserve a la documentation (RFC 2606) : il ne joindra jamais personne.
PGADMIN_DEFAULT_EMAIL=dev@example.com

# Mot de passe de cette interface. Console d'administration locale, jamais
# exposee : valeur de developpement assumee.
PGADMIN_DEFAULT_PASSWORD=pgadmin-dev-password

# Port publie sur le poste ; le conteneur, lui, ecoute sur 80. 5050 est la
# convention la plus repandue pour pgAdmin, se retient face au 5432 de
# PostgreSQL, et evite 8080 -- deja dispute par trop d'outils sur un poste de
# developpement. Console : http://localhost:5050
PGADMIN_HOST_PORT=5050


# ---------------------------------------------------------------------------
# Redis (INFRA-02, BACK-14, BACK-15)
# ---------------------------------------------------------------------------
# Une seule instance, deux usages separes par le NUMERO DE BASE. C'est la
# convention demandee par INFRA-02, exprimee ici par deux variables plutot que
# par un simple commentaire : un `FLUSHDB` sur le cache ne doit jamais emporter
# la file de taches.

# Hote joignable par l'API : nom du service compose ; `localhost` hors Docker.
REDIS_HOST=redis

# Port ecoute dans le reseau Docker.
REDIS_PORT=6379

# Port publie sur le poste. Passer a 6380 si un `brew services start redis`
# occupe deja 6379.
REDIS_HOST_PORT=6379

# Base 0 : cache applicatif (BACK-14).
REDIS_CACHE_DB=0

# Base 1 : broker et backend de resultats de TaskIQ (BACK-15).
REDIS_BROKER_DB=1

# Mot de passe Redis. L'instance de developpement n'en a pas : la variable reste
# COMMENTEE plutot que vide. pydantic-settings lit `REDIS_PASSWORD=` comme la
# chaine vide, pas comme une absence (env_ignore_empty vaut False par defaut).
#REDIS_PASSWORD=

# DSN complet, DERIVE -- meme raisonnement que DATABASE_URL. Le numero de base
# est le dernier segment du chemin : /0 pour le cache, /1 pour le broker.
#REDIS_URL=redis://redis:6379/0

# RedisInsight, console d'inspection optionnelle (INFRA-02), derriere le profil
# compose `tools` : elle ne demarre que sur `--profile tools`, donc ce port
# n'est occupe que sur demande. 5540 est le port natif de RedisInsight 2.
REDISINSIGHT_HOST_PORT=5540


# ---------------------------------------------------------------------------
# MinIO et stockage objet S3 (INFRA-03, BACK-13)
# ---------------------------------------------------------------------------
# MinIO tient lieu d'Amazon S3 en developpement. UN SEUL parametre distingue les
# deux : S3_ENDPOINT_URL. Vide en production, boto3 parle directement a AWS.

# Identifiants racine du serveur MinIO. Noms imposes par l'image `minio/minio`,
# qui exige au moins 3 caracteres pour l'utilisateur et 8 pour le mot de passe.
# Comme pour PostgreSQL, ils ne sont lus qu'a la PREMIERE creation du volume
# `minio_data`.
MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=minio-dev-password

# Port de l'API S3 publie sur le poste. 9000 est aussi le port par defaut de
# php-fpm, de Xdebug et de Portainer : passer a 9010 en cas de conflit.
MINIO_API_HOST_PORT=9000

# Port de la console web publiee sur le poste : http://localhost:9001
# S'y connecter avec MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
MINIO_CONSOLE_HOST_PORT=9001

# Endpoint que contacte le client boto3 de l'API (BACK-13). `minio` est le nom
# du service compose ; hors Docker, http://localhost:9000. LAISSER VIDE en
# production : boto3 retombe alors sur les endpoints Amazon reels.
S3_ENDPOINT_URL=http://minio:9000

# Bucket applicatif, cree au demarrage par le service ephemere `minio-init`
# (INFRA-03). Minuscules et tirets : ce sont les seules regles de nommage
# communes a MinIO et a Amazon S3.
S3_BUCKET=juui-dev

# Region. MinIO l'ignore, mais boto3 REFUSE de construire un client sans region.
# `us-east-1` est la valeur neutre d'usage.
S3_REGION=us-east-1

# Cles d'acces au stockage objet. En developpement elles VALENT les identifiants
# racine MinIO ci-dessus : BACK-13 declare l'alias de repli
# AliasChoices("S3_ACCESS_KEY", "MINIO_ROOT_USER"), ce qui evite d'ecrire deux
# fois la meme valeur dans ce fichier. Les decommenter uniquement pour viser un
# vrai bucket Amazon S3 depuis le poste -- elles prennent alors le dessus.
#S3_ACCESS_KEY=
#S3_SECRET_KEY=


# ---------------------------------------------------------------------------
# Securite et jetons JWT (BACK-10)
# ---------------------------------------------------------------------------
# SETUP-05 nomme la duree d'acces `ACCESS_TOKEN_EXPIRE_MINUTES`, sans prefixe.
# Elle porte ici `JWT_` comme les trois autres, pour que le bloc entier
# corresponde a un unique env_prefix="JWT_" cote BACK-03. C'est le seul
# renommage applique a la liste du ticket.

# Cle de signature des jetons. La valeur ci-dessous n'EST PAS une cle : c'est un
# marqueur, deliberement non hexadecimal pour qu'on ne puisse pas la confondre
# avec une vraie et qu'aucun outil d'analyse de secrets ne la signale.
# En generer une par environnement, jamais partagee entre deux :
#   openssl rand -hex 32
# ou, sans openssl :
#   python -c "import secrets; print(secrets.token_hex(32))"
# La changer invalide TOUS les jetons en circulation : toutes les sessions
# tombent -- c'est exactement l'effet recherche en cas de fuite.
JWT_SECRET_KEY=changer-cette-valeur-voir-openssl-rand-hex-32

# Algorithme de signature. HS256 est symetrique : une seule cle signe et
# verifie, ce qui suffit tant que l'API est le seul emetteur. Passer a RS256
# imposerait une paire de cles, donc deux variables de plus.
JWT_ALGORITHM=HS256

# Duree de vie du jeton d'ACCES, en minutes. Court par construction : c'est lui
# qui circule a chaque requete. 15 minutes est la valeur retenue par BACK-10.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Duree de vie du jeton de RAFRAICHISSEMENT, en jours. Elle fixe au bout de
# combien de temps un utilisateur inactif doit se reconnecter.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ---------------------------------------------------------------------------
# Frontends Next.js (FRONT-01 a FRONT-03, INFRA-05)
# ---------------------------------------------------------------------------
# Les trois conteneurs ecoutent tous sur 3000 a l'interieur du reseau : c'est la
# publication qui les distingue. Rien ne publie 3000 volontairement -- c'est le
# port le plus dispute d'un poste de developpement.
FRONTEND_PROFESSIONAL_HOST_PORT=3001
FRONTEND_INDIVIDUAL_HOST_PORT=3002
FRONTEND_ADMIN_HOST_PORT=3003

# URL de l'API vue par le NAVIGATEUR. Elle doit etre joignable depuis le poste :
# http://localhost:8000, JAMAIS http://api:8000, qui n'est resolvable que par
# les conteneurs. Le prefixe NEXT_PUBLIC_ est ce qui autorise Next.js a exposer
# la variable au code client. Consommee par le mutator Orval (SHARED-03).
#
# PIEGE : Next.js REMPLACE cette variable dans le bundle au moment du BUILD, pas
# a l'execution. En conteneur elle doit donc etre passee en `build.args`
# (INFRA-05) ; la modifier ensuite exige de RECONSTRUIRE l'image -- un simple
# `docker compose restart` ne changera rien.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL de l'API vue par le SERVEUR Next.js : composants serveur, route handlers,
# middleware. En conteneur c'est le nom du service compose. Sans ce second nom,
# tout rendu serveur echouerait en Docker -- ou obligerait a exposer le reseau
# interne au navigateur. Pas de prefixe NEXT_PUBLIC_ : cette adresse n'a aucune
# raison d'atteindre le client.
API_INTERNAL_URL=http://api:8000
